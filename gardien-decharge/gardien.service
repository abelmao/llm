[Unit]
Description=Gardien de décharge (surveillance de la prise connectée)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/gardien-decharge/gardien.py /home/pi/gardien-decharge/config.ini
WorkingDirectory=/home/pi/gardien-decharge
Restart=always
RestartSec=10
User=pi

[Install]
WantedBy=multi-user.target
